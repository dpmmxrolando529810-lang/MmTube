[Unit]
Description=MMTube Web API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mmtube
Group=mmtube
WorkingDirectory=/opt/mmtube/server/web
EnvironmentFile=/etc/mmtube/mmtube.env
ExecStart=/opt/mmtube-venv/bin/python /opt/mmtube/server/web/app.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/mmtube /var/www/mmtube/files /tmp

[Install]
WantedBy=multi-user.target
